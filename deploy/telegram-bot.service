[Unit]
Description=Telegram bot bridge to Hermes Agent
After=network-online.target hermes-gateway.service telegram-bot-api.service
Wants=network-online.target hermes-gateway.service telegram-bot-api.service

[Service]
Type=simple
WorkingDirectory=%h/pet-project-2
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
